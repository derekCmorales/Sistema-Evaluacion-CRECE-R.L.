# Copiar a `.env` en la raíz. No commitear secretos reales.

# --- PostgreSQL (servicio Compose `db`) ---
POSTGRES_USER=crece
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=crece_eval
POSTGRES_PORT=5432

# --- API NestJS ---
API_PORT=3001
NODE_ENV=development

# Host de Postgres:
# - API en Docker (perfil `dev`): host = `db` (nombre del servicio).
# - API con pnpm en la máquina y solo `docker compose up -d db`: host = `localhost`.
DATABASE_URL=postgresql://crece:change-me-in-dev@localhost:5432/crece_eval

# --- Web Next.js ---
WEB_PORT=3000
# El navegador llama a la API desde el host, no desde la red Docker.
NEXT_PUBLIC_API_URL=http://localhost:3001
