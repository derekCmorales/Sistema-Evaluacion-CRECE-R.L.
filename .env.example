# Copiar a .env en la raíz para Docker Compose (no commitear secretos reales).

# PostgreSQL (servicio db)
POSTGRES_USER=crece
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=crece_eval
POSTGRES_PORT=5432

# API NestJS (servicio api)
API_PORT=3001
DATABASE_URL=postgresql://crece:change-me-in-dev@db:5432/crece_eval
NODE_ENV=development

# Web Next.js (servicio web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
