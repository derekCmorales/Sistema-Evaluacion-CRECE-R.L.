# Copiar a `.env` en la raíz. No commitear secretos reales.

# --- PostgreSQL (servicio Compose `db`) ---
POSTGRES_USER=crece
POSTGRES_PASSWORD=change-me-in-dev
POSTGRES_DB=crece_eval
POSTGRES_PORT=5432

# --- API NestJS ---
API_PORT=3001
NODE_ENV=development

# Host de Postgres:
# - API en Docker (perfil `dev`): host = `db` (nombre del servicio).
# - API con pnpm en la máquina y solo `docker compose up -d db`: host = `localhost`.
DATABASE_URL=postgresql://crece:change-me-in-dev@localhost:5432/crece_eval

# --- Web Next.js ---
WEB_PORT=3000
# El navegador llama a la API desde el host, no desde la red Docker.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Motor de IA (docs/ia.md · openspec/changes/ai-review-engine) ---
# Apagado por defecto. Encendido exige las keys de abajo (falla al arrancar si faltan).
AI_ENGINE_ENABLED=false
# Proceso worker (misma imagen de la API, sin HTTP). `pnpm --filter @crece/api dev:worker`
AI_WORKER=false
# Laboratorio /lab/ia: nunca disponible con NODE_ENV=production.
AI_LAB_ENABLED=false
AI_LAB_RETENTION_DAYS=7
AI_LAB_STORAGE_DIR=.lab-storage
# Gemini vía Agent Platform (ex Vertex AI) con authorization key atada a service account.
AI_GOOGLE_BACKEND=agent-platform
AI_GOOGLE_AUTH=api-key
AI_GOOGLE_API_KEY=
# Opcionales con api-key; si se omiten, el SDK usa el endpoint global.
AI_GOOGLE_PROJECT=
AI_GOOGLE_LOCATION=
# OCR: API directa de Mistral (cuenta de prueba mientras se usen datos sintéticos).
MISTRAL_API_KEY=
# Dimensión global de embeddings (128–2000). Cambiarla exige reindexar la base de conocimiento.
AI_EMBEDDING_DIMENSIONS=1536
# Opcional: base distinta para el esquema `ai` (por defecto DATABASE_URL).
AI_DATABASE_URL=
