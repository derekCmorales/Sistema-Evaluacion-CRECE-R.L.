{
  "name": "@crece/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ai:smoke": "node dist/scripts/ai-smoke.js",
    "dev:worker": "node --watch dist/worker.js",
    "start:worker": "node dist/worker.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@crece/ai-engine": "workspace:*",
    "@crece/application": "workspace:*",
    "@crece/domain": "workspace:*",
    "@crece/shared": "workspace:*",
    "@google/genai": "2.24.0",
    "@mistralai/mistralai": "2.7.0",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "pgvector": "0.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@nestjs/schematics": "12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.5",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
