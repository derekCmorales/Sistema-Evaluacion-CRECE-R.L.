{
  "name": "@crece/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "files": ["dist"],
  "dependencies": {
    "@crece/shared": "workspace:*",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.5",
    "@nestjs/schematics": "12.0.4",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "concurrently": "10.0.5",
    "typescript": "7.0.2"
  }
}
