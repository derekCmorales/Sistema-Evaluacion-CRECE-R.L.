  "light": {
    "crece-blue": {
      "$type": "color",
      "$value": "#034381",
      "$description": "Azul oficial del manual. Identidad fija (logo, piezas de marca, splash). En UI usa `brand`."
    },
    "crece-orange": {
      "$type": "color",
      "$value": "#e8973c",
      "$description": "Naranja oficial del manual (la «G» del símbolo). Identidad fija. En UI usa `accent`."
    },
    "crece-gray": {
      "$type": "color",
      "$value": "#363636",
      "$description": "Gris oficial del manual. Impresos y logo a una tinta."
    },
    "bg-canvas": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Fondo base de pantalla/documento."
    },
    "bg-subtle": {
      "$type": "color",
      "$value": "#f3f7fb",
      "$description": "Fondo alterno: secciones, shell de apps, cabeceras de tabla, contenedor de segmentados."
    },
    "bg-surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Superficies: tarjetas, paneles, inputs, barras de navegación."
    },
    "bg-raised": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Superficies elevadas sobre otras: diálogos, bottom sheets, menús, tooltips claros."
    },
    "bg-muted": {
      "$type": "color",
      "$value": "#eaf2f9",
      "$description": "Tinte de marca: contenedores de ícono, ítem activo, resaltados, alerta info."
    },
    "bg-accent-subtle": {
      "$type": "color",
      "$value": "#fff5e8",
      "$description": "Tinte cálido: destacados de ahorro/metas, hover de accesos. Uso puntual."
    },
    "bg-inverse": {
      "$type": "color",
      "$value": "#103b64",
      "$description": "Fondo invertido: toasts/snackbars, tooltips."
    },
    "bg-brand-strong": {
      "$type": "color",
      "$value": "#034381",
      "$description": "Bloques de marca de alto impacto: tarjeta de saldo, splash, cabecera hero de app."
    },
    "border-default": {
      "$type": "color",
      "$value": "#dce5ed",
      "$description": "Bordes y divisores de 1px. Decorativo: no carga significado solo."
    },
    "border-strong": {
      "$type": "color",
      "$value": "#7b8ea1",
      "$description": "Borde de controles (inputs en hover, checkbox, radio). ≥3:1 sobre `bg-surface`."
    },
    "text-primary": {
      "$type": "color",
      "$value": "#103b64",
      "$description": "Titulares, etiquetas, valores. Sobre `bg-canvas`, `bg-surface`, `bg-subtle`, `bg-muted`."
    },
    "text-body": {
      "$type": "color",
      "$value": "#4d6072",
      "$description": "Texto corrido. Sobre `bg-canvas`, `bg-surface`, `bg-subtle`."
    },
    "text-secondary": {
      "$type": "color",
      "$value": "#586b7e",
      "$description": "Ayudas, metadatos, placeholders, captions. ≥4.5:1 sobre `bg-canvas`, `bg-surface`, `bg-subtle`."
    },
    "text-disabled": {
      "$type": "color",
      "$value": "#94a9bb",
      "$description": "Texto de controles deshabilitados (exento de contraste por WCAG)."
    },
    "text-inverse": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Texto sobre `bg-inverse`."
    },
    "text-on-brand-strong": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Texto sobre `bg-brand-strong` y fotografía oscurecida."
    },
    "brand": {
      "$type": "color",
      "$value": "#034381",
      "$description": "Acción principal y énfasis: botón primario, enlaces, íconos activos, cifras destacadas, foco de selección."
    },
    "brand-hover": {
      "$type": "color",
      "$value": "#07569c",
      "$description": "Hover del primario."
    },
    "brand-pressed": {
      "$type": "color",
      "$value": "#103b64",
      "$description": "Estado presionado del primario."
    },
    "on-brand": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Texto/ícono sobre `brand`."
    },
    "accent": {
      "$type": "color",
      "$value": "#e8973c",
      "$description": "Acento cálido de uso medido: CTA destacado (uno por pantalla), FAB, indicadores de novedad, progreso de metas, pulgar de slider."
    },
    "accent-hover": {
      "$type": "color",
      "$value": "#f2a955",
      "$description": "Hover del acento."
    },
    "on-accent": {
      "$type": "color",
      "$value": "#223345",
      "$description": "Texto sobre `accent` (6.3:1). Nunca blanco sobre naranja."
    },
    "success": {
      "$type": "color",
      "$value": "#24714f",
      "$description": "Éxito: aprobado, pagado, completado. Siempre con ícono o palabra."
    },
    "success-bg": {
      "$type": "color",
      "$value": "#eaf6ef",
      "$description": "Fondo de badge/alerta de éxito."
    },
    "warning": {
      "$type": "color",
      "$value": "#945512",
      "$description": "Atención: en revisión, pendiente, vence pronto."
    },
    "warning-bg": {
      "$type": "color",
      "$value": "#fff5e8",
      "$description": "Fondo de badge/alerta de atención."
    },
    "danger": {
      "$type": "color",
      "$value": "#a22d30",
      "$description": "Error, rechazo, acción destructiva, mora."
    },
    "danger-bg": {
      "$type": "color",
      "$value": "#fcecec",
      "$description": "Fondo de badge/alerta de error."
    },
    "info": {
      "$type": "color",
      "$value": "#034381",
      "$description": "Información neutra (alias funcional de brand)."
    },
    "info-bg": {
      "$type": "color",
      "$value": "#eaf2f9",
      "$description": "Fondo de alerta informativa."
    },
    "focus": {
      "$type": "color",
      "$value": "#b86b0e",
      "$description": "Anillo de foco: 3px sólido, offset 2–4px. ≥3:1 sobre todas las superficies."
    },
    "overlay": {
      "$type": "color",
      "$value": "#071c3d80",
      "$description": "Velo tras diálogos, sheets y drawers."
    },
    "skeleton": {
      "$type": "color",
      "$value": "#eef2f6",
      "$description": "Base del skeleton loader."
    },
    "skeleton-shine": {
      "$type": "color",
