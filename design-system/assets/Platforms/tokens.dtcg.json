      "$description": "Brillo animado del skeleton."
    },
    "chart-1": {
      "$type": "color",
      "$value": "#2f6db3",
      "$description": "Serie categórica 1 (azul). Orden fijo, validado para daltonismo."
    },
    "chart-2": {
      "$type": "color",
      "$value": "#e8973c",
      "$description": "Serie 2 (naranja). Bajo 3:1 en claro: exige etiqueta directa o tabla."
    },
    "chart-3": {
      "$type": "color",
      "$value": "#1f9a8a",
      "$description": "Serie 3 (verde azulado)."
    },
    "chart-4": {
      "$type": "color",
      "$value": "#8a5a9e",
      "$description": "Serie 4 (violeta)."
    },
    "chart-5": {
      "$type": "color",
