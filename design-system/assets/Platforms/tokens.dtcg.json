    },
    "chart-6": {
      "$type": "color",
      "$value": "#d0568a",
      "$description": "Serie 6 (rosa). Más de 6 series: agrupa en «Otros»."
    },
    "chart-grid": {
      "$type": "color",
      "$value": "#eef2f6",
      "$description": "Líneas de grilla de gráficas."
    }
  },
